# ─── Event Tracker Backend Environment (example) ────────────────────────────
# Copy to .env for local development. In AWS these come from Secrets Manager.

FLASK_ENV=development
FLASK_SECRET_KEY=change-me-in-production
AWS_REGION=us-east-1

# Database — local dev uses SQLite by default if DATABASE_URL is unset
# Production (RDS MySQL):
# DATABASE_URL=mysql+pymysql://admin:password@event-tracker-db.xxxx.us-east-1.rds.amazonaws.com:3306/eventtracker
DATABASE_URL=

# CloudWatch
CLOUDWATCH_LOG_GROUP=/ecs/event-tracker-app
ENABLE_CLOUDWATCH=false

# CORS
CORS_ORIGINS=http://localhost:3000

# OTP config
OTP_TTL_MINUTES=5
OTP_RETRY_LIMIT=3
OTP_LOCKOUT_MINUTES=15
OTP_RATE_LIMIT_PER_HOUR=5

# Session config
SESSION_TTL_HOURS=8

# External services (leave blank to use console/mock delivery in dev)
SENDGRID_API_KEY=
TWILIO_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=
SENDGRID_FROM_EMAIL=noreply@eventtracker.local

# LLM (Phase 7)
LLM_API_KEY=
